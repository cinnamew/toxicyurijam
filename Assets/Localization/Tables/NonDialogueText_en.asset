      m_Items: []
  - m_Id: 9176400589217792
    m_Localized: Hazel resolves to die, and Mary intervenes.
    m_Metadata:
      m_Items: []
  - m_Id: 9176451424182272
    m_Localized: Hazel learns a thing or two about outward appearances.
    m_Metadata:
      m_Items: []
  - m_Id: 9176486220128256
    m_Localized: "Hazel picks flowers, to Mary\u2019s delight."
    m_Metadata:
      m_Items: []
  - m_Id: 9176514162581504
    m_Localized: Hazel visits town, makes a new friend, and hears a horror story.
    m_Metadata:
      m_Items: []
  - m_Id: 9176708463714304
    m_Localized: Hazel gets a haircut and finds an old scar.
    m_Metadata:
      m_Items: []
  - m_Id: 9176743398072320
    m_Localized: "Hazel takes a bath and admires Mary\u2019s form."
    m_Metadata:
      m_Items: []
  - m_Id: 9176783285903360
    m_Localized: Hazel gets eaten, gets lavender, and gets stared at by strangers.
    m_Metadata:
      m_Items: []
  - m_Id: 9176814420221952
    m_Localized: A visitor comes to call.
    m_Metadata:
      m_Items: []
  - m_Id: 9176824624963584
    m_Localized: Ending 1
    m_Metadata:
      m_Items: []
  - m_Id: 9177740761620480
    m_Localized: Ending 2
    m_Metadata:
      m_Items: []
  - m_Id: 9177758952316928
    m_Localized: Ending 3
    m_Metadata:
      m_Items: []
  - m_Id: 9177722994548736
    m_Localized: Hazel escapes from Mary.
    m_Metadata:
      m_Items: []
  - m_Id: 9177750416908288
    m_Localized: Hazel accepts Mary's love. Their happy ending begins here!
    m_Metadata:
      m_Items: []
  - m_Id: 9177766787276800
    m_Localized: The forbidden potion.
    m_Metadata:
