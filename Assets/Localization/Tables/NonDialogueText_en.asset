      <b>Writing:
      </b>Astra'
    m_Metadata:
      m_Items: []
  - m_Id: 9176085613764608
    m_Localized: "<b>Playtesters:</b> Ommtdh, appletofu12, Caribou, \u200Bhideokinoshita,
      Simone,\u200B soup"
    m_Metadata:
      m_Items: []
  - m_Id: 9176110230134784
    m_Localized: '<b><u>Content Warnings:</b></u>

      violence, light gore/blood,
      death, abuse, implied sexual trauma, exploitation, profanity, brief mentions
