  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 1194
  indentLevel: 0
  storyText: I bite my lip to fight back the tears. I'm already getting some stares
    from the crowd.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
