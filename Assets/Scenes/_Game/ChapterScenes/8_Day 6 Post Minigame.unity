  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 1186
  indentLevel: 0
  storyText: In the centre of the town square is a makeshift gallows.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
