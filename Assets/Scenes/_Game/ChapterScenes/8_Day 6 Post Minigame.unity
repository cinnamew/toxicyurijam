  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 1193
  indentLevel: 0
  storyText: Why not Mary? She's the one they were hunting for, right? She's the
    damned witch! She's the one who... deserves... to...
