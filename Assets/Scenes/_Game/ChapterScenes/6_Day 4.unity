  indentLevel: 0
  commenterName: 
  commentText: '(BG: Witch''s House Night)'
--- !u!114 &1623802442
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1623801741}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 713
  indentLevel: 0
  storyText: The day passes peacefully for a while. I had borrowed a few books on
    alchemy from Mary's workroom, and I pass the time with reading.{wc}I eat mutton
    for lunch, while Mary watches on like she always does.{wc}And then, late in the
    day, as evening approaches, I suddenly hear a noise.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
