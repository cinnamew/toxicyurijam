  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 701
  indentLevel: 0
  storyText: I stare for a moment at my reflection. It's been a while since I've
    seen it last.{wc}I am given the distinct impression that I am staring at a small
    beast, a rabbit or a shrew, caught in a hunter's trap.{wc}I look dishevelled,
    and unkempt, but at least my hair is now perfectly neat and tidy.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
