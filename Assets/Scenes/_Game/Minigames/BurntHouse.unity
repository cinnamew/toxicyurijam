  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 59
  indentLevel: 0
  storyText: '{i}I clamber back out of the wreckage, and look back at the priest,
    who is staring at me in shock.{/i}'
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
