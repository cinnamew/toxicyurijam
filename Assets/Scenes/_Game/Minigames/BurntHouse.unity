  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 26
  indentLevel: 0
  storyText: I've heard that once the fire had burned itself out, a few of the villagers
    tore through the house, looking for "evidence of witchcraft". This would appear
    to be the result of their search.
  description: 
  character: {fileID: 1240484597}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
